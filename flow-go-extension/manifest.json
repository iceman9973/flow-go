{
  "manifest_version": 3,
  "name": "Flow Go Bridge",
  "version": "1.0.0",
  "description": "Flow-specific browser bridge for the flow-go backend. Supplies the cookies, identity, reCAPTCHA token and in-page upscale it needs — and nothing else.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "cookies",
    "alarms",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://google.com/*",
    "http://google.com/*",
    "https://accounts.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:*"
  },
  "action": {
    "default_title": "Flow Go Bridge",
    "default_popup": "popup.html"
  }
}
