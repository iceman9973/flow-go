# flow-go configuration
#
# Every value here has a working default. Copy to .env to override; real
# environment variables always win over this file.

# ─── Flow project ────────────────────────────────────────────────────────────
# Leave empty and the engine finds a project by itself, preferring the account's
# own project list (RPC UpteDb) over reading an open editor's URL — the listing
# is equally current and does not navigate a tab. Run `flow-go projects` to see
# the list, or GET /v1/projects.
#
# Setting this skips every search, including the listing call.
#
# Ranking, highest first: the --project-id flag, then this, then the listing,
# then the open editor's URL.
#
# A wrong id fails visibly: a project belongs to one signed-in account, so
# another account's id does not open.
#
# Any uuid works, including one that has never existed — the server accepts it
# and generation succeeds, so there is no registration step to miss. The catch is
# that such a project never appears in the app's project list, so use a real one
# if you will want to find the work again later.
# FLOW_PROJECT_ID=

# ─── Network ─────────────────────────────────────────────────────────────────
# Route every upstream call for this account through one exit IP. Flow scores
# requests partly on IP consistency, so a stable proxy measurably improves
# success rates. Supports http:// and socks5://.
# FLOW_PROXY=

# Public Flow client key. Ships in the browser bundle, so it is not a secret.
# Overridable so a rotated key does not require a rebuild.
# FLOW_API_KEY=

# Supply a bearer token directly instead of minting one from cookies.
# Useful for a one-off test; the normal path is cookies.
# FLOW_ACCESS_TOKEN=

# ─── reCAPTCHA ───────────────────────────────────────────────────────────────
# auto   — broker if the extension is attached, then HTTP, then no token
# broker — ask the browser to run grecaptcha.enterprise.execute (best score)
# http   — speak the Enterprise anchor/reload protocol with no browser
# off    — send no token, exactly like the Python engine
# FLOW_RECAPTCHA=auto
# FLOW_RECAPTCHA_SITE_KEY=

# ─── Ports ───────────────────────────────────────────────────────────────────
# WS_PORT is where the browser-Cdp extension dials in.
# WS_PORT=9222
# HTTP_PORT=8200

# ─── Account selection ───────────────────────────────────────────────────────
# ACCOUNT_INDEX seeds which signed-in Google account to act as, as an `authuser`
# index. It is only a seed: once POST /v1/accounts/switch has been used, the index
# it recorded in the `settings` table wins, so a deliberate choice is not undone
# by the next restart.
# ACCOUNT_INDEX=0

# How many account indices are examined when looking for one that can pay for a
# job. Chrome permits ten, but the scan costs a session, a profile and a balance
# read per index and it runs on the request path.
# ACCOUNT_SCAN_LIMIT=6

# ─── Paths ───────────────────────────────────────────────────────────────────
# FLOW_DATA_DIR=./data
# FLOW_OUTPUT_DIR=./output
# FLOW_COOKIE_DIR=./cookies
# FLOW_DB_PATH=./data/flow.db

# ─── Timings ─────────────────────────────────────────────────────────────────
# POLL_INTERVAL=10          # seconds between generation status polls
# POLL_TIMEOUT=420          # seconds to wait for one generation
# REQUEST_TIMEOUT=90        # seconds for one upstream HTTP call
# SESSION_TTL=2400          # seconds a minted access token is trusted

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Google throttles accounts that fire bursts at Flow, and the throttle surfaces
# as UNUSUAL_ACTIVITY rather than a clean 429. These defaults are conservative.
# MAX_CONCURRENT_REQUESTS=4
# REQUEST_MIN_INTERVAL=2.0

# ─── Generation defaults ─────────────────────────────────────────────────────
# IMAGE_MODEL=NARWHAL       # HARBOR_SEAL, NARWHAL, or GEM_PIX_2
