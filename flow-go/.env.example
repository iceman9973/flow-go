# flow-go configuration
#
# Every value here has a working default. Copy to .env to override; real
# environment variables always win over this file.

# ─── Flow Project ────────────────────────────────────────────────────────────
# Leave empty and the engine automatically discovers the project from the browser
# or account project list (RPC UpteDb). Run `./flow-go projects` to inspect.
# FLOW_PROJECT_ID=

# ─── Network & Upstream ──────────────────────────────────────────────────────
# Route upstream calls through an exit IP (supports http:// and socks5://).
# Flow scores IP consistency, so a stable residential proxy improves success rates.
# FLOW_PROXY=

# Public Flow client key (ships in the browser bundle).
# FLOW_API_KEY=

# Upstream frontend build label (overrides the default without recompilation).
# FLOW_BUILD_LABEL=boq_labs-ai-sandbox-frontend_20260917.09_p0

# Supply a bearer token directly for manual testing (ordinary path uses cookies).
# FLOW_ACCESS_TOKEN=

# ─── reCAPTCHA Strategy ──────────────────────────────────────────────────────
# auto   — Pure server-side HTTP challenge minting (default, headless-friendly)
# broker — Asks the browser extension / Flow page to mint token (best score)
# http   — Forces server-side HTTP protocol
# off    — Sends empty token (testing only)
# FLOW_RECAPTCHA=auto
# FLOW_RECAPTCHA_SITE_KEY=

# ─── Ports ───────────────────────────────────────────────────────────────────
# WS_PORT is where the Chrome Bridge extension dials in (default 9222).
# HTTP_PORT is the REST API server port (default 8200).
# WS_PORT=9222
# HTTP_PORT=8200

# ─── Account Selection ───────────────────────────────────────────────────────
# ACCOUNT_INDEX seeds which signed-in Google account (authuser index) to start with.
# ACCOUNT_INDEX=0

# Max account indices scanned when finding a balance that can pay for a job.
# ACCOUNT_SCAN_LIMIT=6

# ─── Paths (Strict Separation) ───────────────────────────────────────────────
# FLOW_DATA_DIR: SQLite database and internal runtime data only.
# FLOW_COOKIE_DIR: Active cookies, fingerprint, page-tokens, and bridge-token only.
# FLOW_OUTPUT_DIR: Downloaded images and videos.
# FLOW_DATA_DIR=./data
# FLOW_COOKIE_DIR=./cookies
# FLOW_OUTPUT_DIR=./output
# FLOW_DB_PATH=./data/flow.db

# ─── Timings & Engine Bounds ─────────────────────────────────────────────────
# POLL_INTERVAL=10          # seconds between generation status polls
# POLL_TIMEOUT=420          # seconds to wait for one generation
# REQUEST_TIMEOUT=90        # seconds for one upstream HTTP call
# SESSION_TTL=2400          # seconds a minted access token is trusted

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# Guards against Google's UNUSUAL_ACTIVITY throttle.
# MAX_CONCURRENT_REQUESTS=4
# REQUEST_MIN_INTERVAL=2.0

# ─── Generation Defaults ─────────────────────────────────────────────────────
# IMAGE_MODEL=NARWHAL       # HARBOR_SEAL, NARWHAL, or GEM_PIX_2
