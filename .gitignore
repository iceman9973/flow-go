# Build artifacts. The binary is named after the module, so it sits beside the
# module rather than at the repository root.
/flow-go/flow-go
/flow-go/flow
/dist/
*.exe
*.test
*.mp4

# macOS metadata
.DS_Store

# Runtime state — never commit these. They sit beside the module because the
# paths are resolved against the working directory the binary runs from.
/flow-go/data/
/flow-go/output/
/flow-go/cookies/
/flow-go/flow.log
*.log
.env
config.env

# Anything that looks like a credential dump
cookies*.json
*_export*.json
